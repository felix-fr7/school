// Prisma ORM Schema
// Multi-Tenant School Management System
// This file defines the database structure and relationships

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

/// User role enumeration for 4-tier system
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

/// Attendance status enumeration
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Fee status enumeration
enum FeeStatus {
  PAID
  PARTIAL
  UNPAID
  WAIVED
}

// ============================================
// Core Models
// ============================================

/// Tenant (School) model - represents a school/tenant
model Tenant {
  id          String     @id @default(uuid())
  name        String     // School name
  code        String     @unique // Unique school code for identification
  address     String?
  phone       String?
  email       String?
  isActive    Boolean    @default(true)
  users       User[]
  classes     Class[]
  homeworks   Homework[]
  marks       Mark[]
  news        News[]
  circulars   Circular[]
  examSchedules ExamSchedule[]
  attendances Attendance[]
  fees        Fee[]
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("tenants")
  @@index([code])
}

/// User model - stores user authentication and profile data
model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String
  name        String
  phone       String?    // Phone number for teachers and admins
  role        Role       @default(STUDENT)
  tenantId    String?    // Null for Super Admin
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String?    @unique // For students - unique student ID within school
  classId     String?    // For students - current class; for teachers - class they teach
  class       Class?     @relation(fields: [classId], references: [id], onDelete: SetNull)
  taughtClass Class?     @relation("ClassTeacher") // The class this teacher teaches (homeroom teacher)
  posts       Post[]
  homeworks   Homework[] // Homework assigned by this admin/teacher to students
  marks       Mark[]     // Marks entered by this admin/teacher
  news        News[]     // News posted by this admin/teacher (relation for postedByUser)
  circulars   Circular[] // Circulars issued by this admin/teacher (relation for issuedByUser)
  attendances Attendance[] // Attendance records for students
  fee         Fee?     // Fee record for student (one-to-one)
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("users")
  @@index([email])
  @@index([tenantId])
  @@index([role])
  @@index([studentId])
}

/// Class/Grade model - represents a class within a school
model Class {
  id          String     @id @default(uuid())
  name        String     // Class name (e.g., "10th Grade", "Class A")
  section     String?    // Section/division (e.g., "A", "B")
  teacherId   String?    @unique // Class teacher (homeroom teacher) ID - unique because one teacher per class
  teacher     User?      @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students    User[]
  homeworks   Homework[]
  examSchedules ExamSchedule[]
  attendances Attendance[] // Attendance records for this class
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("classes")
  @@index([tenantId])
  @@index([name])
  @@index([teacherId])
}

// ============================================
// Content Models (Admin-controlled, Student-visible)
// ============================================

/// Homework model - assignments posted by Admin/Teachers
model Homework {
  id          String     @id @default(uuid())
  title       String
  description String
  subject     String     // Subject name
  classId     String
  class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedBy  String     // User ID of admin/teacher who created it
  assignedByUser User?   @relation(fields: [assignedBy], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("homeworks")
  @@index([tenantId])
  @@index([classId])
  @@index([isPublished])
}

/// Mark model - student marks/grades posted by Admin/Teachers
model Mark {
  id          String     @id @default(uuid())
  studentId   String
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String     // Subject name
  marksObtained Float    // Marks obtained
  totalMarks  Float      // Maximum marks
  percentage  Float?     // Calculated percentage
  grade       String?    // Grade (A, B, C, etc.)
  examType    String     // (e.g., "Mid Term", "Final", "Unit Test")
  examDate    DateTime?
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  remarks     String?    // Teacher remarks
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("marks")
  @@index([tenantId])
  @@index([studentId])
  @@index([examType])
}

/// News model - school news/announcements
model News {
  id          String     @id @default(uuid())
  title       String
  content     String
  summary     String?
  category    String?    // Category (e.g., "Sports", "Academic", "Event")
  imageUrl    String?    // Optional image URL
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postedBy    String     // User ID of admin who created it
  postedByUser User?    @relation(fields: [postedBy], references: [id], onDelete: SetNull)
  isPublished Boolean    @default(true)
  publishDate DateTime?  // Date to publish (can be scheduled)
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("news")
  @@index([tenantId])
  @@index([isPublished])
}

/// Circular model - official circulars/notifications
model Circular {
  id          String     @id @default(uuid())
  title       String
  content     String
  circularNo  String?    // Circular number for reference
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuedBy    String     // User ID of admin who created it
  issuedByUser User?    @relation(fields: [issuedBy], references: [id], onDelete: SetNull)
  isPublished Boolean    @default(true)
  issueDate   DateTime   @default(now())
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("circulars")
  @@index([tenantId])
  @@index([isPublished])
}

/// Exam Schedule model
model ExamSchedule {
  id          String     @id @default(uuid())
  title       String     // Exam name
  subject     String
  date        DateTime   // Exam date
  time        String     // Exam time (e.g., "09:00 AM - 12:00 PM")
  duration    Int?       // Duration in minutes
  roomNo      String?    // Room number
  classId     String
  class       Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("createdAt")
  updatedAt   DateTime   @updatedAt @map("updatedAt")

  @@map("exam_schedules")
  @@index([tenantId])
  @@index([classId])
}

// ============================================
// Legacy Post Model (for backward compatibility)
// ============================================

/// Post model - stores user-created content
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("posts")
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Attendance & Fee Models (Production Additions)
// ============================================

/// Attendance model - daily attendance tracking for students
model Attendance {
  id          String            @id @default(uuid())
  date        DateTime          // Date of attendance
  status      AttendanceStatus  @default(PRESENT) // PRESENT, ABSENT, LATE, EXCUSED
  studentId   String
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     String
  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  remarks     String?           // Optional remarks (e.g., reason for absence)
  markedBy    String?           // User ID who marked attendance (teacher/admin)
  createdAt   DateTime          @default(now()) @map("createdAt")
  updatedAt   DateTime          @updatedAt @map("updatedAt")

  @@map("attendance")
  @@unique([date, studentId]) // Prevent duplicate attendance entries per student per day
  @@index([tenantId])
  @@index([classId])
  @@index([studentId])
  @@index([date])
}

/// Fee model - student fee management and tracking
model Fee {
  id            String      @id @default(uuid())
  studentId     String      @unique // One-to-one relation with student
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  totalAmount   Float       // Total fee amount for the term/year
  paidAmount    Float       @default(0) // Amount paid so far
  balanceAmount Float       // Remaining amount (calculated)
  status        FeeStatus   @default(UNPAID) // PAID, PARTIAL, UNPAID, WAIVED
  dueDate       DateTime?   // Fee due date
  paymentDate   DateTime?   // Date when fee was fully paid
  remarks       String?     // Optional remarks
  createdAt     DateTime    @default(now()) @map("createdAt")
  updatedAt     DateTime    @updatedAt @map("updatedAt")

  @@map("fees")
  @@index([tenantId])
  @@index([studentId])
  @@index([status])
}
