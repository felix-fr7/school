# MACVEL School Management App - Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Felixraj*270603
DB_NAME=macvel_school

# JWT Secret (Change this to a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cloudinary (primary storage for PDFs, images and files)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# When unset the backend falls back to local disk storage in ./uploads
CLOUDINARY_URL=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=