# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# SQLite format: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret Key
# Generate a strong random key for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT Expiration
JWT_EXPIRES_IN=7d

# CORS Configuration
# Add your frontend URL(s) here
FRONTEND_URL="http://localhost:19006"

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Super Admin Default Credentials (for initial setup)
SUPER_ADMIN_EMAIL="superadmin@school.com"
SUPER_ADMIN_PASSWORD="SuperAdmin@123"
SUPER_ADMIN_NAME="Super Admin"