# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================

# For PostgreSQL with Connection Pooling (Supabase, etc.)
# - pgbouncer=true: Enables connection pooling mode
# - connection_limit=5: Max 5 connections per PrismaClient instance
# - pool_timeout=30: Wait up to 30 seconds to get a connection
# DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=5&pool_timeout=30"

# For direct PostgreSQL connection (bypasses pooler for migrations)
# Use non-pooler port (5432) for DDL operations
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=false&connection_limit=1"

# For SQLite (development only)
DATABASE_URL="file:./dev.db"

# ============================================
# JWT Configuration
# ============================================

# JWT Secret Key
# Generate a strong random key for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT Expiration
JWT_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
# Note: CORS is now handled dynamically in server.js
# The server automatically accepts requests from:
# - localhost (any port)
# - Local network IPs (192.168.x.x, 10.x.x.x, 172.16-31.x.x)
# - ngrok domains (ngrok-free.dev, ngrok-free.app, etc.)
# This variable is kept for reference but is no longer strictly required
FRONTEND_URL="http://localhost:5173,http://localhost:19006"

# ============================================
# Security Configuration
# ============================================

# Bcrypt Salt Rounds (10 is good for development, use 12+ for production)
BCRYPT_SALT_ROUNDS=10

# ============================================
# Super Admin Default Credentials
# ============================================
# For initial setup only - change after first login!
SUPER_ADMIN_EMAIL="superadmin@school.com"
SUPER_ADMIN_PASSWORD="SuperAdmin@123"
SUPER_ADMIN_NAME="Super Admin"

# ============================================
# Supabase Storage Configuration (for file uploads)
# ============================================
# Required for lesson attachments and file uploads
# Get these from your Supabase project settings:
# - Project URL: https://your-project.supabase.co
# - Service Role Key: Found in Settings > API > Service Role Key
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
